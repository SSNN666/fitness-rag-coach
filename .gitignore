# 虚拟环境
.venv/
env/
venv/
ENV/

# Python 缓存
__pycache__/
*.py[cod]
*.so

# 本地向量库 & 嵌入式数据库
chroma_db/
faiss_index/
milvus.db/
milvus_data/
test_milvus.db/
bm25_index.pkl

# 项目备份
*.tar.gz

# 缓存 & 日志
fact_cache.json
pdf_ocr_cache.json
gateway.log
*.log

# 知识图谱页运行时生成（echarts.min.js 为静态依赖需入库，graph.html 每次重跑覆盖）
static/graph.html

# PDF 原始文件与页面图片（版权资料，永不入库）
*.pdf
pdf_pages/

# 合规资料源文件（二进制不入库；txt 抽取版在 TEXT_KB_SOURCES 中入库）
kb_*.docx

# 密钥文件（真实密钥在 .env，勿提交；.env.example 可入库）
.env

# IDE配置
.idea/
.vscode/

# 操作系统文件
.DS_Store
Thumbs.db

# 依赖文件（除了 pyproject.toml 和 requirements.txt 外，其他的类似 .uv 缓存可以忽略）
.uv/
uv.lock