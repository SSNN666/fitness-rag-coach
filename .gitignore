# 虚拟环境
.venv/
env/
venv/
ENV/

# Python 缓存
__pycache__/
*.py[cod]
*.so

# 本地向量库 & 嵌入式数据库
chroma_db/
faiss_index/
milvus.db/
milvus_data/
test_milvus.db/
bm25_index.pkl

# 项目备份
*.tar.gz

# 缓存 & 日志
fact_cache.json
pdf_ocr_cache.json
gateway.log
*.log

# 用户反馈数据（含用户问题与评价，运行时生成，不入库）
feedback.jsonl

# 知识图谱页运行时生成（echarts.min.js 为静态依赖需入库，graph.html 每次重跑覆盖）
static/graph.html

# PDF 原始文件与页面图片（版权资料，永不入库）
*.pdf
pdf_pages/

# 合规资料源文件（二进制不入库；txt 抽取版在 TEXT_KB_SOURCES 中入库）
kb_*.docx

# 密钥文件（真实密钥在 .env，勿提交；.env.example 可入库）
.env

# IDE配置
.idea/
.vscode/

# 操作系统文件
.DS_Store
Thumbs.db

# 屏幕截图等临时文件
屏幕截图*.png

# uv 缓存（uv.lock 必须入库：CI `uv sync --frozen` 依赖它与 pyproject 同步）
.uv/
# 数据清理备份（本地保留，不入库）
*.bak

# 本机系统维护脚本（个人工具，非项目产物；曾误入库，2026-09-11 移出）
cleanup_c.bat

# 会话记忆落盘（含用户对话内容，运行时生成，不入库）
sessions.json
# 成本账本（运行时生成，不入库；入库会让「本机用量」变成仓库里的陈旧数字）
cost_state.json
ingest_manifest.json
embed_cache.json
