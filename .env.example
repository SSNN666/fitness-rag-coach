# 复制为 .env 并填入真实密钥（.env 不入库，已在 .gitignore）

# ===== 云端大模型（主链路）=====
# 阿里云百炼 DashScope API Key（https://bailian.console.aliyun.com → API-KEY）
# 空 = 跳过 DashScope，直接本地 Ollama
DASHSCOPE_API_KEY=
# 自定义 MaaS 部署地址（私有化部署时需要；公共云留空用默认 dashscope.aliyuncs.com）
DASHSCOPE_BASE_URL=
# 百度千帆 API Key（可选第二云供应商，格式 bce-v3/ALTAK-...）
# 空 = 降级链自动跳过千帆
QIANFAN_API_KEY=

# ===== 内容审核（百度智能云 AK/SK，与千帆 Key 不同）=====
BAIDU_AK=
BAIDU_SK=

# ===== 接口鉴权（演示级：自定字符串即可；空 = 本地免鉴权）=====
API_KEY_AUTH=

# ===== Neo4j AuraDB（NEO4J_ENABLED=True 时才需要）=====
NEO4J_PASSWORD=

# ===== CRAG 联网搜索（博查 AI，https://open.bochaai.com）=====
BOCHA_API_KEY=
